@inherits LayoutComponentBase
@implements IDisposable

@using Microsoft.AspNetCore.Components.Authorization
@using BlazorClient.Services.Connectivity
@using BlazorClient.Services.Offline
@using BlazorClient.Services.Sync

@inject AuthenticationStateProvider AuthStateProvider
@inject BlazorClient.Services.Auth.AuthService AuthService
@inject NavigationManager Nav
@inject OnlineStatusService Online
@inject IOfflineDb OfflineDb
@inject ISyncService Sync
@inject PendingCounterService Pending

<div class="page">
    <aside class="sidebar">
        <NavMenu />
    </aside>
    <main class="main">
        <header class="top-row flex-wrap">
            <div class="topbar-brand">Warehouses Management Studio</div>

            <div class="topbar-status d-flex align-items-center flex-wrap gap-2 ms-auto justify-content-end">
                <!-- Online/Offline indicator -->
                <span class="badge @(Online.IsOnline ? "bg-success" : "bg-secondary")"
                      title="Connection status">
                    @if (Online.IsOnline)
                    {
                        <i class="bi bi-wifi"></i>
                    }
                    else
                    {
                        <i class="bi bi-wifi-off"></i>
                    }
                </span>

                <!-- Pending queue counter + manual sync -->
                <span class="text-muted small" title="Pending items to sync">
                    <b>UnSynced:</b> @Pending.Count
                </span>
                <button class="btn btn-sm btn-outline-primary"
                        title="Sync pending now"
                        @onclick="SyncNow"
                        disabled="@(Pending.Count == 0)">
                    Sync now
                </button>

                <!-- Auth status -->
                <div class="auth-status d-flex align-items-center flex-wrap gap-2 ms-2">
                    <AuthorizeView>
                        <Authorized Context="auth">
                            <span class="small text-light">Logged in as <strong>@auth.User.Identity!.Name</strong></span>
                            <button class="btn btn-sm btn-outline-danger" @onclick="DoLogout">Logout</button>
                        </Authorized>
                        <NotAuthorized Context="na">
                            <a class="btn btn-sm btn-outline-primary" href="login">Login</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </header>

        <section class="content">
            @Body
        </section>
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // αρχική τιμή από IndexedDB
        var initial = (await OfflineDb.GetPendingAsync()).Count;
        Pending.Set(initial);

        Pending.Changed += OnPendingChanged;
        Online.StatusChanged += OnOnlineChanged;
    }

    private void OnPendingChanged() => InvokeAsync(StateHasChanged);

    private async void OnOnlineChanged(bool _)
    {
        var current = (await OfflineDb.GetPendingAsync()).Count;
        Pending.Set(current);
    }

    private async Task SyncNow()
    {
        await Sync.SyncPendingAsync();
        StateHasChanged();
    }

    private async Task DoLogout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("login", forceLoad: true);
    }

    public void Dispose()
    {
        Pending.Changed -= OnPendingChanged;
        Online.StatusChanged -= OnOnlineChanged;
    }
}
