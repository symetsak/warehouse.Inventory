@* NavMenu.razor *@
<div class="nav-header">
    <span class="nav-title">WMS</span>
    <button class="nav-toggle" @onclick="ToggleNavMenu">≡</button>
</div>

<div class="nav-scrollable @NavMenuCssClass">
    <nav class="flex-column">
        <AuthorizeView>
            <Authorized Context="auth">
                <div class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill"></span>
                        <span class="ms-2">Home</span>
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="products" Match="NavLinkMatch.Prefix">
                        <span class="bi bi-box-seam"></span>
                        <span class="ms-2">Products</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="warehouses" Match="NavLinkMatch.Prefix">
                        <span class="bi bi-bank2"></span>
                        <span class="ms-2">Warehouses</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="inventory" Match="NavLinkMatch.Prefix">
                        <span class="bi bi-journal-text"></span>
                        <span class="ms-2">Inventory</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="users" Match="NavLinkMatch.Prefix">
                        <span class="bi bi-people"></span>
                        <span class="ms-2">Users</span>
                    </NavLink>
                </div>
            </Authorized>

            @* Optional: δείξε μόνο link για Login όταν δεν είναι authenticated *@
            <NotAuthorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="login" Match="NavLinkMatch.All">
                        <span class="bi bi-box-arrow-in-right"></span>
                        <span class="ms-2">Login</span>
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool collapseNavMenu = false;
    private string NavMenuCssClass => collapseNavMenu ? "collapsed" : "show";
    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
}
