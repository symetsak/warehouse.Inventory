@page "/reset-password"
@using BlazorClient.Services.Auth
@using System.ComponentModel.DataAnnotations
@inject AuthService Auth
@inject NavigationManager Nav

<div class="edit-container">
    <div class="edit-card">
        <div class="edit-header">
            <h3 class="edit-title">Reset Password</h3>
        </div>

        <EditForm Model="@model" OnValidSubmit="@OnSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="edit-body two-col">
                <div class="form-block">
                    <label>Username</label>
                    <InputText @bind-Value="model.Username" class="form-control" />
                    <div class="help-text">Enter your account username.</div>
                </div>

                <div class="form-block">
                    <label>Current password</label>
                    <div class="input-group">
                        <InputText class="form-control"
                                   type="@(showCur ? "text" : "password")"
                                   @bind-Value="model.CurrentPassword" />
                        <button type="button" class="btn btn-outline-secondary"
                                @onclick="() => showCur = !showCur">
                            @(showCur ? "Hide" : "Show")
                        </button>
                    </div>
                </div>

                <div class="form-block">
                    <label>New password</label>
                    <div class="input-group">
                        <InputText class="form-control"
                                   type="@(showNew ? "text" : "password")"
                                   @bind-Value="model.NewPassword" />
                        <button type="button" class="btn btn-outline-secondary"
                                @onclick="() => showNew = !showNew">
                            @(showNew ? "Hide" : "Show")
                        </button>
                    </div>
                    <div class="help-text">Min length: 6 characters.</div>
                </div>

                <div class="form-block">
                    <label>Confirm new password</label>
                    <div class="input-group">
                        <InputText class="form-control"
                                   type="@(showConfirm ? "text" : "password")"
                                   @bind-Value="model.ConfirmNewPassword" />
                        <button type="button" class="btn btn-outline-secondary"
                                @onclick="() => showConfirm = !showConfirm">
                            @(showConfirm ? "Hide" : "Show")
                        </button>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger m-3 mb-0">@error</div>
            }
            @if (success)
            {
                <div class="alert alert-success m-3 mb-0">
                    Password changed. You can now <a href="/login">log in</a>.
                </div>
            }

            <div class="edit-footer">
                <button type="submit" class="btn btn-primary" disabled="@busy">
                    @(busy ? "Please wait..." : "Change password")
                </button>
                <button type="button" class="btn btn-secondary" @onclick="BackToLogin">
                    Back to login
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private ResetModel model = new();
    private bool busy, success;
    private string? error;

    // show/hide flags
    private bool showCur, showNew, showConfirm;

    private Task BackToLogin() { Nav.NavigateTo("/login"); return Task.CompletedTask; }

    private async Task OnSubmit()
    {
        error = null; success = false;

        if (model.NewPassword != model.ConfirmNewPassword)
        {
            error = "Passwords do not match.";
            return;
        }

        busy = true;
        var (ok, msg) = await Auth.ResetPasswordAsync(model.Username.Trim(), model.CurrentPassword, model.NewPassword);
        busy = false;

        if (ok) success = true;
        else error = msg ?? "Unexpected error.";
    }

    private sealed class ResetModel
    {
        [Required] public string Username { get; set; } = string.Empty;
        [Required] public string CurrentPassword { get; set; } = string.Empty;
        [Required, MinLength(6)] public string NewPassword { get; set; } = string.Empty;
        [Required] public string ConfirmNewPassword { get; set; } = string.Empty;
    }
}
