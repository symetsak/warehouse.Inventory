@page "/product-edit/{Id:int?}"
@using BlazorClient.Services
@using Shared.DTOs
@inject IProductService ProductService
@inject NavigationManager NavManager

<h3>@(Id == null ? "Create Product" : "Edit Product")</h3>

<EditForm Model="model" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Code</label>
        <InputText @bind-Value="model.Code" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Name</label>
        <InputText @bind-Value="model.Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Description</label>
        <InputText @bind-Value="model.Description" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Unit</label>
        <InputText @bind-Value="model.Unit" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Quantity</label>
        <InputNumber @bind-Value="model.Quantity" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Price</label>
        <InputNumber @bind-Value="model.Price" class="form-control" />
    </div>
    <div class="mb-3">
        <label>WarehouseId</label>
        <InputNumber @bind-Value="model.WarehouseId" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <button type="button" class="btn btn-secondary ms-2" @onclick='() => NavManager.NavigateTo("/products")'>Cancel</button>
</EditForm>

@code {
    [Parameter]
    public int? Id { get; set; }

    private CreateProductDto model = new();

    protected override async Task OnInitializedAsync()
    {
        if (Id != null)
        {
            var dto = await ProductService.GetByIdAsync(Id.Value);
            if (dto != null)
            {
                // Χαρτογράφηση ProductDto -> CreateProductDto
                model = new CreateProductDto
                {
                    Code = dto.Code,
                    Name = dto.Name,
                    Description = dto.Description,
                    Unit = dto.Unit,
                    Quantity = dto.Quantity,
                    Price = dto.Price,
                    WarehouseId = dto.WarehouseId
                };
            }
        }
    }

    async Task HandleValidSubmit()
    {
        if (Id == null)
            await ProductService.CreateAsync(model);
        else
            await ProductService.UpdateAsync(Id.Value, model);

        NavManager.NavigateTo("/products");
    }
}