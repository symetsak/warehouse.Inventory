@page "/inventory-edit/{Id:int?}"
@attribute [Authorize]
@using BlazorClient.Services
@using BlazorClient.Services.Auth
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web   <!-- KeyboardEventArgs -->
@using Shared.DTOs
@inject IInventoryService InventoryService
@inject IProductService ProductService
@inject NavigationManager NavManager
@inject AuthService AuthService

<div class="edit-container">
    <div class="edit-card">
        <div class="edit-header">
            <h3 class="edit-title">@(Id == null ? "Create Inventory" : "Edit Inventory")</h3>
        </div>

        <EditForm Model="model" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="edit-body two-col">
                <!-- ScanCode + Camera Scan button -->
                <div class="form-block">
                    <label>ScanCode</label>
                    <div class="input-group">
                        <InputText @bind-Value="model.ScanCode"
                                   class="form-control"
                                   @onkeydown:stopPropagation
                                   @onkeyup="OnScanEnter" />
                        <button type="button"
                                class="btn btn-outline-primary"
                                title="Scan with camera"
                                @onclick="() => scanVisible = true">
                            Scan
                        </button>
                    </div>
                </div>

                <div class="form-block">
                    <label>Επιλογή Προϊόντος</label>
                    <InputSelect @bind-Value="SelectedProductId" class="form-select">
                        <option value="">-- Επιλογή προϊόντος --</option>
                        @foreach (var p in products)
                        {
                            <option value="@p.Id">@p.Code - @p.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => model.Code" />
                </div>

                <div class="form-block">
                    <label>Ενέργεια</label>
                    <InputSelect @bind-Value="model.Action" class="form-select">
                        <option value="Input">Είσοδος</option>
                        <option value="Output">Έξοδος</option>
                    </InputSelect>
                    <ValidationMessage For="() => model.Action" />
                </div>

                <div class="form-block">
                    <label>Ποσότητα</label>
                    <InputNumber @bind-Value="model.Quantity" class="form-control" />
                    <ValidationMessage For="() => model.Quantity" />
                </div>

                <div class="form-block">
                    <label>Αποθήκη (WarehouseId)</label>
                    <InputNumber @bind-Value="model.WarehouseId" class="form-control" disabled />
                </div>

                <div class="form-block">
                    <label>Χρήστης</label>
                    <input class="form-control" value="@currentUserFullName" disabled />
                </div>
            </div>

            <div class="edit-footer">
                <button type="submit" class="btn btn-primary">Save</button>
                <button type="button" class="btn btn-secondary" @onclick='() => NavManager.NavigateTo("/inventory")'>Cancel</button>
            </div>
        </EditForm>
    </div>
</div>

<!-- Camera scanner modal -->
<ScanDialog Visible="@scanVisible"
            VisibleChanged="v => scanVisible = v"
            OnResult="OnCameraScanned" />

<!-- Dialog αντιστοίχισης barcode όταν είναι άγνωστο -->
<LinkBarcodeDialog Visible="@linkVisible"
                   VisibleChanged="v => linkVisible = v"
                   ScannedCode="@pendingUnknownCode"
                   OnLinked="OnBarcodeLinked" />

@code {
    [Parameter] public int? Id { get; set; }

    private CreateInventoryDto model = new();
    private List<ProductDto> products = new();
    private string? currentUserFullName;

    private int? _selectedProductId;
    private bool linkVisible;            // άνοιγμα/κλείσιμο αντιστοίχισης
    private bool scanVisible;            // άνοιγμα/κλείσιμο κάμερας
    private string? pendingUnknownCode;  // κρατά το άγνωστο barcode

    private int? SelectedProductId
    {
        get => _selectedProductId;
        set
        {
            if (_selectedProductId == value) return;
            _selectedProductId = value;

            var p = products.FirstOrDefault(x => x.Id == value);
            if (p is not null)
            {
                model.Code = p.Code;
                model.WarehouseId = p.WarehouseId;
            }
            else
            {
                model.Code = null;
                model.WarehouseId = 0;
            }
            InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        products = (await ProductService.GetAllAsync()).ToList();

        var me = await AuthService.GetCurrentUserAsync();
        if (me is not null)
        {
            model.UserId = me.Id;
            currentUserFullName = me.FullName;
        }

        if (Id != null)
        {
            var dto = await InventoryService.GetByIdAsync(Id.Value);
            if (dto != null)
            {
                model = new CreateInventoryDto
                {
                    ScanCode = dto.ScanCode,
                    Code = dto.Code,
                    Action = dto.Action,
                    Quantity = dto.Quantity,
                    WarehouseId = dto.WarehouseId,
                    UserId = model.UserId != 0 ? model.UserId : dto.UserId
                };

                var prod = products.FirstOrDefault(x => x.Code.Equals(dto.Code, StringComparison.OrdinalIgnoreCase));
                SelectedProductId = prod?.Id;
            }
        }
        else
        {
            model.Action = "Input";
            model.Quantity = 0;
            SelectedProductId = null;
        }
    }

    // Keyboard scan (Enter)
    private async Task OnScanEnter(KeyboardEventArgs e)
    {
        if (e.Key is not ("Enter" or "NumpadEnter")) return;
        var code = (model.ScanCode ?? "").Trim();
        if (string.IsNullOrWhiteSpace(code)) return;
        await HandleBarcodeAsync(code);
    }

    // Camera scan result
    private async Task OnCameraScanned(string code)
    {
        model.ScanCode = code;
        await HandleBarcodeAsync(code);
    }

    // Κοινή ροή για keyboard & camera
    private async Task HandleBarcodeAsync(string code)
    {
        var p = await ProductService.GetByBarcodeAsync(code);

        if (p is not null)
        {
            SetSelectedProduct(p.Id);
            return;
        }

        pendingUnknownCode = code;
        linkVisible = true;
        StateHasChanged();
    }

    // callback από το LinkBarcodeDialog μετά το Save
    private Task OnBarcodeLinked((int productId, string code) e)
    {
        model.ScanCode = e.code;
        SetSelectedProduct(e.productId);
        return Task.CompletedTask;
    }

    private void SetSelectedProduct(int productId)
    {
        SelectedProductId = productId;
        var p = products.FirstOrDefault(x => x.Id == productId);
        if (p is not null)
        {
            model.Code = p.Code;
            model.WarehouseId = p.WarehouseId;
        }
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        if (Id == null)
            await InventoryService.CreateAsync(model);
        else
            await InventoryService.UpdateAsync(Id.Value, model);

        NavManager.NavigateTo("/inventory");
    }
}
