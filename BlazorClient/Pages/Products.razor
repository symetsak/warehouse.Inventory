@page "/products"
@attribute [Authorize]

@using BlazorClient.Services
@using Microsoft.AspNetCore.Authorization
@using Shared.DTOs
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization

@inject IProductService ProductService
@inject IJSRuntime JsRuntime

<div class="wms-header">
    <h3 class="mb-0">Products</h3>
    <input class="form-control wms-search"
           placeholder="Search..."
           @bind="searchText" 
           @bind:event="oninput"
           @bind:after="OnSearchChanged" />
</div>

<!-- Admin-only action buttons -->
<AuthorizeView Roles="Admin">
    <div class="mb-3 d-flex gap-2 flex-wrap">
        <button class="btn btn-primary" @onclick="AddProduct">Add</button>
        <button class="btn btn-secondary" @onclick="EditProduct" disabled="@(!CanEdit)">Edit</button>
        <button class="btn btn-danger" @onclick="DeleteProduct" disabled="@(!CanEdit)">Delete</button>
    </div>
    <div class="mb-4 d-flex gap-2 flex-wrap">
        <button class="btn btn-success" @onclick="SaveProduct" disabled="@(!CanSave)">Save</button>
        <button class="btn btn-warning" @onclick="CancelEdit" disabled="@(!isEditing)">Cancel</button>
    </div>
</AuthorizeView>

@if (products is null)
{
    <p><em>Loading...</em></p>
}
else if (VisibleCount == 0)
{
    <p>No products found.</p>
}
else
{
    <EditForm Model="formData">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Code</label>
                <InputText @bind-Value="formData.Code" class="form-control" readonly="@(!(isAdmin && isEditing))" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Name</label>
                <InputText @bind-Value="formData.Name" class="form-control" readonly="@(!(isAdmin && isEditing))" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Unit</label>
                <InputText @bind-Value="formData.Unit" class="form-control" readonly="@(!(isAdmin && isEditing))" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Description</label>
                <InputTextArea @bind-Value="formData.Description" class="form-control" rows="2" readonly="@(!(isAdmin && isEditing))" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Quantity</label>
                <InputNumber @bind-Value="formData.Quantity" class="form-control" @oninput="ComputeTotal" readonly="@(!(isAdmin && isEditing))" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Price</label>
                <InputNumber @bind-Value="formData.Price" class="form-control" @oninput="ComputeTotal" readonly="@(!(isAdmin && isEditing))" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Total</label>
                <InputNumber @bind-Value="formData.TotalValue" class="form-control" readonly />
            </div>
            <div class="col-md-3">
                <label class="form-label">WarehouseId</label>
                <InputNumber @bind-Value="formData.WarehouseId" class="form-control" readonly="@(!(isAdmin && isEditing))" />
            </div>
        </div>
    </EditForm>

    <nav>
        <ul class="pagination justify-content-center mt-4 flex-wrap">

            <!-- Πρώτη -->
            <li class="page-item @(currentIndex == 0 ? "disabled" : "")">
                <button class="page-link"
                        @onclick="() => ChangeIndex(0)"
                        disabled="@(currentIndex == 0)">
                    &laquo;
                </button>
            </li>

            <!-- Προηγούμενη -->
            <li class="page-item @(currentIndex == 0 ? "disabled" : "")">
                <button class="page-link"
                        @onclick="() => ChangeIndex(currentIndex - 1)"
                        disabled="@(currentIndex == 0)">
                    &lt;
                </button>
            </li>

            @foreach (var i in DisplayPages)
            {
                <li class="page-item @(i == currentIndex ? "active" : "")">
                    <button class="page-link" @onclick="() => ChangeIndex(i)">@(i + 1)</button>
                </li>
            }

            <!-- Επόμενη -->
            <li class="page-item @(currentIndex >= VisibleCount - 1 ? "disabled" : "")">
                <button class="page-link"
                        @onclick="() => ChangeIndex(currentIndex + 1)"
                        disabled="@(currentIndex >= VisibleCount - 1)">
                    &gt;
                </button>
            </li>

            <!-- Τελευταία -->
            <li class="page-item @(currentIndex >= VisibleCount - 1 ? "disabled" : "")">
                <button class="page-link"
                        @onclick="() => ChangeIndex(VisibleCount - 1)"
                        disabled="@(currentIndex >= VisibleCount - 1)">
                    &raquo;
                </button>
            </li>

        </ul>
    </nav>

}

<!-- Shared confirm dialog -->
<BlazorClient.Shared2.ConfirmDialog Visible="showDeleteModal"
                                    Title="Are you sure to delete ?"
                                    Message="@deleteMessage"
                                    OnConfirm="ConfirmDelete"
                                    OnCancel="CancelDelete" />

@code {
    // ---- auth ----
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    private bool isAdmin;

    // ---- state ----
    private List<ProductDto> products = new();
    private ProductDto formData = new ProductDto();
    private int currentIndex;
    private bool isEditing;
    private bool isNew;
    private ProductDto previousData = new ProductDto();
    private bool showDeleteModal = false;
    private string deleteMessage = "";

    // ---- search ----
    private string searchText = string.Empty;

    // Προκύπτουσα φιλτραρισμένη λίστα (on-demand)
    private List<ProductDto> View =>
        (products ?? new List<ProductDto>()).Where(Matches).ToList();

    private int VisibleCount => View.Count;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateTask).User;
        isAdmin = user.IsInRole("Admin");

        products = (await ProductService.GetAllAsync()).ToList();
        if (VisibleCount > 0)
            await ChangeIndex(0);
    }

    private async Task OnSearchChanged()
    {
        // Με το που αλλάζει το search, πήγαινε στο 1ο ορατό αποτέλεσμα (αν υπάρχει)
        if (VisibleCount > 0) await ChangeIndex(0);
        else formData = new ProductDto();
    }

    private async Task ChangeIndex(int index)
    {
        var list = View;
        if (list.Count == 0) { formData = new ProductDto(); return; }

        if (index < 0) index = 0;
        if (index >= list.Count) index = list.Count - 1;

        currentIndex = index;
        formData = Clone(list[index]);
        previousData = Clone(formData);
        isEditing = false;
        isNew = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ComputeTotal(ChangeEventArgs _) =>
        formData.TotalValue = formData.Quantity * formData.Price;

    private void AddProduct()
    {
        if (!isAdmin) return;
        previousData = Clone(formData);
        formData = new ProductDto();
        isNew = true;
        isEditing = true;
    }

    private void EditProduct()
    {
        if (!CanEdit) return;
        previousData = Clone(formData);
        isEditing = true;
    }

    private async Task SaveProduct()
    {
        if (!CanSave) return;

        var dto = new CreateProductDto
        {
            Code = formData.Code,
            Name = formData.Name,
            Description = formData.Description ?? string.Empty,
            Unit = formData.Unit,
            Quantity = formData.Quantity,
            Price = formData.Price,
            WarehouseId = formData.WarehouseId
        };

        try
        {
            if (isNew)
            {
                var created = await ProductService.CreateAsync(dto);
                products = (await ProductService.GetAllAsync()).ToList();
                var list = View;
                var idx = list.FindIndex(p => p.Id == created.Id);
                await ChangeIndex(idx >= 0 ? idx : 0);
            }
            else
            {
                await ProductService.UpdateAsync(formData.Id, dto);
                var i = products.FindIndex(p => p.Id == formData.Id);
                if (i >= 0) products[i] = Clone(formData);
                await ChangeIndex(currentIndex);
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"Error saving: {ex.Message}");
        }
        finally
        {
            isEditing = false;
            isNew = false;
        }
    }

    private void DeleteProduct()
    {
        if (!CanEdit) return;
        deleteMessage = $"{formData.Code} - {formData.Name}";
        showDeleteModal = true;
    }

    private async Task ConfirmDelete()
    {
        showDeleteModal = false;
        if (!isAdmin) return;

        await ProductService.DeleteAsync(formData.Id);

        var i = products.FindIndex(p => p.Id == formData.Id);
        if (i >= 0) products.RemoveAt(i);

        if (VisibleCount > 0)
            await ChangeIndex(Math.Min(currentIndex, VisibleCount - 1));
        else
            formData = new ProductDto();
    }

    private void CancelDelete() => showDeleteModal = false;

    private void CancelEdit()
    {
        if (!isEditing) return;
        formData = Clone(previousData);
        isEditing = false;
        isNew = false;
    }

    private ProductDto Clone(ProductDto src) => new ProductDto
    {
        Id = src.Id,
        Code = src.Code,
        Name = src.Name,
        Description = src.Description,
        Unit = src.Unit,
        Quantity = src.Quantity,
        Price = src.Price,
        TotalValue = src.TotalValue,
        WarehouseId = src.WarehouseId,
        WarehouseName = src.WarehouseName
    };

    // Sliding window up to 3 pages, πάνω στη φιλτραρισμένη λίστα
    private IEnumerable<int> DisplayPages
    {
        get
        {
            var total = VisibleCount;
            const int max = 3;
            if (total == 0) yield break;
            int half = max / 2;
            int start = currentIndex - half;
            if (start < 0) start = 0;
            if (start + max > total) start = Math.Max(0, total - max);
            int end = Math.Min(start + max, total);
            for (int i = start; i < end; i++)
                yield return i;
        }
    }

    private bool Matches(ProductDto p)
    {
        var q = (searchText ?? string.Empty).Trim();
        if (q.Length == 0) return true;

        bool Has(string? s) => !string.IsNullOrEmpty(s) &&
                               s.Contains(q, StringComparison.OrdinalIgnoreCase);

        return Has(p.Code)
            || Has(p.Name)
            || Has(p.Unit)
            || Has(p.Description)
            || p.Quantity.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
            || p.Price.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
            || p.TotalValue.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
            || p.WarehouseId.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
            || Has(p.WarehouseName);
    }

    // μόνο Admin επιτρέπει edit/save/delete
    private bool CanEdit => VisibleCount > 0 && !isEditing && isAdmin;
    private bool CanSave => isEditing && isAdmin;
}
