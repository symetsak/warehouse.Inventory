@page "/products"
@using BlazorClient.Services
@using Shared.DTOs
@using Microsoft.AspNetCore.Components.Forms
@inject IProductService ProductService
@inject IJSRuntime JsRuntime

<h3>Products</h3>

<div class="mb-3">
    <button type="button" class="btn btn-primary me-2" @onclick="AddProduct">Add</button>
    <button type="button" class="btn btn-secondary me-2" @onclick="ToggleEdit">@(isEditing ? "Cancel" : "Edit")</button>
    <button type="button" class="btn btn-danger" @onclick="DeleteProduct" disabled="@(products == null || !products.Any())">Delete</button>
    <button type="button" class="btn btn-success ms-2" @onclick="SaveProduct" disabled="@( !isEditing )">Save</button>
</div>

@if (products is null)
{
    <p><em>Loading...</em></p>
}
else if (!products.Any())
{
    <p>No products found.</p>
}
else
{
    <EditForm Model="formData" class="mb-4">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Code</label>
                <InputText @bind-Value="formData.Code" class="form-control" readonly="@(!isEditing)" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Name</label>
                <InputText @bind-Value="formData.Name" class="form-control" readonly="@(!isEditing)" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Quantity</label>
                <InputNumber @bind-Value="formData.Quantity" class="form-control" readonly="@(!isEditing)" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Price</label>
                <InputNumber @bind-Value="formData.Price" class="form-control" readonly="@(!isEditing)" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Total</label>
                <InputNumber @bind-Value="formData.TotalValue" class="form-control" readonly="true" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Warehouse</label>
                <InputText @bind-Value="formData.WarehouseName" class="form-control" readonly="true" />
            </div>
        </div>
    </EditForm>

    <nav>
        <ul class="pagination justify-content-center">
            @for (int i = 0; i < products.Count; i++)
            {
                <li class="page-item @(i == currentIndex ? "active" : "")">
                    <button type="button" class="page-link" @onclick="() => ChangeIndex(i)">@(i + 1)</button>
                </li>
            }
        </ul>
    </nav>
}

@code {
    private List<ProductDto>? products;
    private ProductDto formData = new();
    private int currentIndex = 0;
    private bool isEditing = false;
    private bool isNew = false;

    protected override async Task OnInitializedAsync()
    {
        products = (await ProductService.GetAllAsync()).ToList();
        if (products.Any())
        {
            await ChangeIndex(0);
        }
    }

    private async Task ChangeIndex(int idx)
    {
        if (products == null || idx < 0 || idx >= products.Count) return;
        currentIndex = idx;
        formData = new ProductDto
        {
            Id = products[idx].Id,
            Code = products[idx].Code,
            Name = products[idx].Name,
            Quantity = products[idx].Quantity,
            Price = products[idx].Price,
            TotalValue = products[idx].TotalValue,
            WarehouseName = products[idx].WarehouseName
        };
        isEditing = false;
        isNew = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleEdit()
    {
        if (products == null || !products.Any()) return;
        isEditing = !isEditing;
        if (!isEditing && !isNew)
        {
            // Revert changes
#pragma warning disable BL0005
            _ = ChangeIndex(currentIndex);
#pragma warning restore BL0005
        }
    }

    private void AddProduct()
    {
        isNew = true;
        isEditing = true;
        formData = new ProductDto();
    }

    private async Task SaveProduct()
    {
        if (isNew)
        {
            var created = await ProductService.CreateAsync(new CreateProductDto
            {
                Code = formData.Code,
                Name = formData.Name,
                Quantity = formData.Quantity,
                Price = formData.Price,
                // Map other required fields if any
            });
            products.Add(created);
            await ChangeIndex(products.Count - 1);
        }
        else
        {
            await ProductService.UpdateAsync(formData.Id, new CreateProductDto
            {
                Code = formData.Code,
                Name = formData.Name,
                Quantity = formData.Quantity,
                Price = formData.Price,
                // Map other required fields if any
            });
            products[currentIndex] = formData;
            await InvokeAsync(StateHasChanged);
        }
        isEditing = false;
        isNew = false;
    }

    private async Task DeleteProduct()
    {
        if (products == null || !products.Any()) return;

        if (await JsRuntime.InvokeAsync<bool>("confirm", "Delete this product?"))
        {
            await ProductService.DeleteAsync(formData.Id);
            products.RemoveAt(currentIndex);
            if (products.Any())
            {
                await ChangeIndex(0);
            }
            else
            {
                formData = new ProductDto();
                isEditing = false;
            }
        }
    }
}
