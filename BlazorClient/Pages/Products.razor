@page "/products"
@attribute [Authorize]

@using BlazorClient.Services
@using Microsoft.AspNetCore.Authorization
@using Shared.DTOs
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization

@inject IProductService ProductService
@inject IWarehouseService WarehouseService
@inject IJSRuntime JsRuntime

<div class="wms-header">
    <h3 class="mb-0">Products</h3>
    <input class="form-control wms-search"
           placeholder="Search..."
           @bind="searchText"
           @bind:event="oninput"
           @bind:after="OnSearchChanged" />
</div>

<!-- Admin-only action buttons -->
<AuthorizeView Roles="Admin">
    <div class="mb-3 d-flex gap-2 flex-wrap">
        <button class="btn btn-primary" @onclick="AddProduct"><i class="bi bi-plus-square"></i></button>
        <button class="btn btn-secondary" @onclick="EditProduct" disabled="@(!CanEdit)"><i class="bi bi-pencil-square"></i></button>
        <button class="btn btn-danger" @onclick="DeleteProduct" disabled="@(!CanEdit)"><i class="bi bi-trash"></i></button>
    </div>
    <div class="mb-4 d-flex gap-2 flex-wrap">
        <button class="btn btn-success" @onclick="SaveProduct" disabled="@(!CanSave)">Save</button>
        <button class="btn btn-warning" @onclick="CancelEdit" disabled="@(!isEditing)">Cancel</button>
    </div>
</AuthorizeView>

@if (products is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="products-container">
        <!-- ===== LEFT SIDE: PRODUCT TABLE ===== -->
        <div class="products-list">
            @if (products.Any())
            {
                <div class="table-responsive wms">
                    <div class="wms-table-wrap">
                        <table class="table table-striped table-hover wms-table wms-table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Name</th>
                                    <th>Warehouse</th>
                                    <th class="text-end actions-cell">Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var p in products)
                                {
                                    <tr class="@(formData.Id == p.Id ? "table-primary" : "")">
                                        <td>@p.Code</td>
                                        <td>@p.Name</td>
                                        <td>@p.WarehouseName</td>
                                        <td class="text-end actions-cell">
                                            <button class="btn btn-secondary btn-sm"
                                                    @onclick="() => ViewProduct(p.Id)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <p>No products found.</p>
            }
        </div>


        <!-- ===== RIGHT SIDE: PRODUCT FORM ===== -->
        <div class="product-detail">
            @if (formData != null && (formData.Id > 0 || isNew))
            {
                <EditForm Model="formData">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Code</label>
                            <InputText @bind-Value="formData.Code" class="form-control" readonly="@(!(isAdmin && isEditing))" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Name</label>
                            <InputText @bind-Value="formData.Name" class="form-control" readonly="@(!(isAdmin && isEditing))" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Unit</label>
                            <InputText @bind-Value="formData.Unit" class="form-control" readonly="@(!(isAdmin && isEditing))" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Description</label>
                            <InputTextArea @bind-Value="formData.Description" class="form-control" rows="2" readonly="@(!(isAdmin && isEditing))" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Quantity</label>
                            <InputNumber @bind-Value="formData.Quantity" class="form-control" @oninput="ComputeTotal" readonly="@(!(isAdmin && isEditing))" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Price</label>
                            <InputNumber @bind-Value="formData.Price" class="form-control" @oninput="ComputeTotal" readonly="@(!(isAdmin && isEditing))" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Total</label>
                            <InputNumber @bind-Value="formData.TotalValue" class="form-control" readonly />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Warehouse</label>
                            @if (isAdmin && isEditing)
                            {
                                <InputSelect @bind-Value="formData.WarehouseId" class="form-select" @onchange="OnWarehouseChanged">
                                    <option value="">-- Select Warehouse --</option>
                                    @foreach (var w in warehouses)
                                    {
                                        <option value="@w.Id">@w.Name</option>
                                    }
                                </InputSelect>
                            }
                            else
                            {
                                <InputText @bind-Value="formData.WarehouseName" class="form-control" readonly />
                            }
                        </div>
                    </div>
                </EditForm>
            }
            else
            {
                <p class="text-muted mt-4">Select a product to view details.</p>
            }
        </div>
    </div>
}

<!-- Shared confirm dialog -->
<!-- Shared confirm dialog -->
<BlazorClient.SharedComponents.ConfirmDialog Visible="showDeleteModal"
                                    Title="Διαγραφή Προϊόντος"
                                    Message="@($"Θέλεις σίγουρα να διαγράψεις το προϊόν {SelectedProduct?.Name} (Code: {SelectedProduct?.Code});")"
                                    CancelText="Ακύρωση"
                                    ConfirmText="Διαγραφή"
                                    OnConfirm="ConfirmDelete"
                                    OnCancel="CancelDelete" />



@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    private bool isAdmin;

    private ProductDto? SelectedProduct;
    private List<ProductDto> products = new();
    private List<WarehouseDto> warehouses = new();
    private ProductDto formData = new();
    private ProductDto previousData = new();
    private bool isEditing;
    private bool isNew;
    private bool showDeleteModal = false;
    private string deleteMessage = "";
    private string searchText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateTask).User;
        isAdmin = user.IsInRole("Admin");

        warehouses = (await WarehouseService.GetAllAsync()).ToList();
        products = (await ProductService.GetAllAsync()).ToList();
    }

    private async Task ViewProduct(int id)
    {
        var product = products.FirstOrDefault(x => x.Id == id);
        if (product != null)
        {
            formData = Clone(product);
            previousData = Clone(product);
            isEditing = false;
            isNew = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnWarehouseChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            formData.WarehouseId = id;
            formData.WarehouseName = warehouses.FirstOrDefault(x => x.Id == id)?.Name ?? string.Empty;
        }
    }

    private void ComputeTotal(ChangeEventArgs _) =>
        formData.TotalValue = formData.Quantity * formData.Price;

    private void AddProduct()
    {
        if (!isAdmin) return;
        previousData = Clone(formData);
        formData = new ProductDto { WarehouseId = 0, WarehouseName = string.Empty };
        isNew = true;
        isEditing = true;
    }

    private void EditProduct()
    {
        if (!CanEdit) return;
        previousData = Clone(formData);
        isEditing = true;
    }

    private async Task SaveProduct()
    {
        if (!CanSave) return;

        var dto = new CreateProductDto
        {
            Code = formData.Code,
            Name = formData.Name,
            Description = formData.Description ?? string.Empty,
            Unit = formData.Unit,
            Quantity = formData.Quantity,
            Price = formData.Price,
            WarehouseId = formData.WarehouseId
        };

        if (formData.WarehouseId <= 0)
        {
            await JsRuntime.InvokeVoidAsync("alert", "Please select a warehouse.");
            return;
        }

        try
        {
            if (isNew)
            {
                var created = await ProductService.CreateAsync(dto);
                products = (await ProductService.GetAllAsync()).ToList();
                await ViewProduct(created.Id);
            }
            else
            {
                await ProductService.UpdateAsync(formData.Id, dto);
                var i = products.FindIndex(p => p.Id == formData.Id);
                if (i >= 0) products[i] = Clone(formData);
                await ViewProduct(formData.Id);
            }
        }
        catch (Exception ex)
        {
            await JsRuntime.InvokeVoidAsync("alert", $"Error saving: {ex.Message}");
        }
        finally
        {
            isEditing = false;
            isNew = false;
        }
    }

    private void DeleteProduct()
    {
        if (!CanEdit) return;
        SelectedProduct = formData; // το επιλεγμένο προϊόν
        showDeleteModal = true;
    }

    private async Task ConfirmDelete()
    {
        showDeleteModal = false;
        if (!isAdmin || SelectedProduct is null) return;

        await ProductService.DeleteAsync(SelectedProduct.Id);
        products.RemoveAll(p => p.Id == SelectedProduct.Id);
        formData = new ProductDto();
        SelectedProduct = null;
    }

    private void CancelDelete()
    {
        showDeleteModal = false;
        SelectedProduct = null;
    }


    private void CancelEdit()
    {
        if (!isEditing) return;
        formData = Clone(previousData);
        isEditing = false;
        isNew = false;
    }

    private ProductDto Clone(ProductDto src) => new()
    {
        Id = src.Id,
        Code = src.Code,
        Name = src.Name,
        Description = src.Description,
        Unit = src.Unit,
        Quantity = src.Quantity,
        Price = src.Price,
        TotalValue = src.TotalValue,
        WarehouseId = src.WarehouseId,
        WarehouseName = src.WarehouseName
    };

    private async Task OnSearchChanged()
    {
        if (products.Count == 0) return;
        products = (await ProductService.GetAllAsync()).Where(Matches).ToList();
    }

    private bool Matches(ProductDto p)
    {
        var q = (searchText ?? string.Empty).Trim();
        if (q.Length == 0) return true;
        bool Has(string? s) => !string.IsNullOrEmpty(s) && s.Contains(q, StringComparison.OrdinalIgnoreCase);

        return Has(p.Code)
            || Has(p.Name)
            || Has(p.Unit)
            || Has(p.Description)
            || Has(p.WarehouseName);
    }

    private bool CanEdit => formData.Id > 0 && !isEditing && isAdmin;
    private bool CanSave => isEditing && isAdmin;
}