@page "/login"
@using Microsoft.AspNetCore.Components.Forms
@inject BlazorClient.Services.Auth.AuthService AuthService
@inject NavigationManager Nav

<div class="container d-flex justify-content-center align-items-start align-items-lg-center py-5 py-lg-0" style="min-height: 80vh;">
    <div class="card shadow-sm border-0" style="max-width: 480px; width: 100%;">
        <div class="card-body p-4 p-lg-5">

            <!-- Header -->
            <div class="d-flex align-items-center mb-3">
                <div class="rounded-3 bg-primary text-white fw-bold d-inline-flex align-items-center justify-content-center" style="width:48px;height:48px;">WMS</div>
                <div class="ms-3">
                    <h5 class="mb-0">Sign in</h5>
                    <small class="text-muted">Warehouses Management Studio</small>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Error))
            {
                <div class="alert alert-danger py-2" role="alert">@Error</div>
            }

            <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">
                <DataAnnotationsValidator />

                <!-- Username -->
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <InputText id="username" class="form-control" @bind-Value="loginModel.Username" autocomplete="username" />
                    <ValidationMessage For="@(() => loginModel.Username)" />
                </div>

                <!-- Password (με Show/Hide) -->
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <div class="input-group">
                        <InputText id="password"
                                   class="form-control"
                                   @bind-Value="loginModel.Password"
                                   type="@(_showPassword ? "text" : "password")"
                                   autocomplete="current-password" />
                        <button type="button" class="btn btn-outline-secondary" @onclick="TogglePassword">
                            @(_showPassword ? "Hide" : "Show")
                        </button>
                    </div>
                    <ValidationMessage For="@(() => loginModel.Password)" />
                </div>

                <!-- Options row -->
                <div class="d-flex justify-content-between align-items-center mb-3">    
                    <a class="text-decoration-none" href="/reset-password">Reset password</a>
                </div>

                <!-- Submit -->
                <button type="submit" class="btn btn-primary w-100" disabled="@_submitting">
                    @if (_submitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Signing in…</span>
                    }
                    else
                    {
                        <span>Login</span>
                    }
                </button>
            </EditForm>

        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string? Error;
    private bool _showPassword;
    private bool _submitting;

    private void TogglePassword() => _showPassword = !_showPassword;

    private async Task HandleLogin()
    {
        Error = null;
        _submitting = true;
        try
        {
            var ok = await AuthService.LoginAsync(loginModel.Username, loginModel.Password);
            if (ok)
            {
                Nav.NavigateTo("/");
                return;
            }
            Error = "Invalid username or password.";
        }
        catch
        {
            Error = "Κάτι πήγε στραβά. Δοκίμασε ξανά.";
        }
        finally
        {
            _submitting = false;
        }
    }

    public class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Το username είναι υποχρεωτικό")]
        public string Username { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Ο κωδικός είναι υποχρεωτικός")]
        public string Password { get; set; } = string.Empty;
    }
}
