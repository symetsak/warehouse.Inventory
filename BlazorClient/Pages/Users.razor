@page "/users"
@attribute [Authorize]
@using BlazorClient.Services
@using Microsoft.AspNetCore.Authorization
@using Shared.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@inject IUserService UserService
@inject NavigationManager NavManager
@inject IJSRuntime JsRuntime

<h3>Users</h3>

<!-- Create: μόνο Admin -->
<AuthorizeView Roles="Admin">
    <button class="btn btn-primary mb-3" @onclick="CreateNew">Create New User</button>
</AuthorizeView>

@if (users is null)
{
    <p><em>Loading...</em></p>
}
else if (!users.Any())
{
    <p>No users found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Username</th>
                <th>Email</th>
                <th>Mobile</th>
                <th>Role</th>

                <!-- Στήλη ενεργειών: μόνο Admin -->
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <th></th>
                    </Authorized>
                </AuthorizeView>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in users)
            {
                <tr>
                    <td>@u.FullName</td>
                    <td>@u.Username</td>
                    <td>@u.Email</td>
                    <td>@u.Mobile</td>
                    <td>@u.Role</td>

                    <!-- Κουμπιά Edit/Delete: μόνο Admin -->
                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <td>
                                <button class="btn btn-sm btn-secondary me-1" @onclick="() => Edit(u.Id)">Edit</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => Delete(u.Id)">Delete</button>
                            </td>
                        </Authorized>
                    </AuthorizeView>
                </tr>
            }
        </tbody>
    </table>
}

<!-- Modal επιβεβαίωσης -->
<BlazorClient.Shared2.ConfirmDialog Visible="showDeleteDialog"
                                    Title="Are you sure to delete ?"
                                    Message="@deleteMessage"
                                    OnConfirm="ConfirmDelete"
                                    OnCancel="CancelDelete" />

@code {
    private List<UserDto>? users;

    private bool showDeleteDialog;
    private string deleteMessage = string.Empty;
    private int pendingDeleteUserId;

    protected override async Task OnInitializedAsync()
    {
        users = (await UserService.GetAllAsync()).ToList();
    }

    void CreateNew() => NavManager.NavigateTo("/user-edit");
    void Edit(int id) => NavManager.NavigateTo($"/user-edit/{id}");

    async Task Delete(int id)
    {
        pendingDeleteUserId = id;
        var u = users?.FirstOrDefault(x => x.Id == id);
        deleteMessage = u is null
            ? "Delete this user?"
            : $"User \"{u.FullName}\" (@{u.Username})?";
        showDeleteDialog = true;
        await Task.CompletedTask;
    }

    private async Task ConfirmDelete()
    {
        showDeleteDialog = false;
        await UserService.DeleteAsync(pendingDeleteUserId);
        users = (await UserService.GetAllAsync()).ToList();
    }

    private void CancelDelete() => showDeleteDialog = false;
}
