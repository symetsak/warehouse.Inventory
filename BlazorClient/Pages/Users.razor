@page "/users"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using BlazorClient.Services
@using Shared.DTOs

@inject IUserService UserService
@inject NavigationManager NavManager

<div class="wms-header">
    <h3 class="mb-0">Users</h3>
    <input class="form-control wms-search" placeholder="Search..."
           @bind="searchText" @bind:event="oninput" />
</div>

<AuthorizeView Roles="Admin">
    <button class="btn btn-primary mb-3" @onclick="CreateNew">Create New User</button>
</AuthorizeView>

@if (users is null)
{
    <p><em>Loading...</em></p>
}
else if (!Filtered.Any())
{
    <p>No users found.</p>
}
else
{
    <div class="table-responsive wms">
        <div class="wms-table-wrap">
            <table class="table table-striped table-hover wms-table wms-table-sm">
                <thead>
                    <tr>
                        <th>Full Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Mobile</th>
                        <th>Role</th>
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                <th class="text-end">Actions</th>
                            </Authorized>
                        </AuthorizeView>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Filtered)
                    {
                        <tr>
                            <td>@u.FullName</td>
                            <td>@u.Username</td>
                            <td>@u.Email</td>
                            <td>@u.Mobile</td>
                            <td>
                                @if (string.Equals(u.Role, "Admin", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge text-bg-primary">Admin</span>
                                }
                                else if (string.Equals(u.Role, "Employee", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge text-bg-success">Employee</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">@u.Role</span>
                                }
                            </td>
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <td class="text-end wms-row-actions">
                                        <button class="btn btn-secondary btn-sm me-1" @onclick="() => Edit(u.Id)">Edit</button>
                                        <button class="btn btn-danger btn-sm" @onclick="() => Delete(u.Id)">Delete</button>
                                    </td>
                                </Authorized>
                            </AuthorizeView>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<BlazorClient.Shared2.ConfirmDialog Visible="showDeleteDialog"
                                    Title="Are you sure to delete ?"
                                    Message="@deleteMessage"
                                    OnConfirm="ConfirmDelete"
                                    OnCancel="CancelDelete" />

@code {
    private List<UserDto>? users;
    private string searchText = string.Empty;

    private bool showDeleteDialog;
    private string deleteMessage = string.Empty;
    private int pendingDeleteUserId;

    protected override async Task OnInitializedAsync()
    {
        users = (await UserService.GetAllAsync()).ToList();
    }

    private IEnumerable<UserDto> Filtered =>
        string.IsNullOrWhiteSpace(searchText)
        ? users ?? Enumerable.Empty<UserDto>()
        : (users ?? Enumerable.Empty<UserDto>())
            .Where(u =>
                Has(u.FullName) || Has(u.Username) || Has(u.Email) || Has(u.Mobile) || Has(u.Role));

    bool Has(string? s) =>
        !string.IsNullOrEmpty(s) && s.Contains(searchText, StringComparison.OrdinalIgnoreCase);

    void CreateNew() => NavManager.NavigateTo("/user-edit");
    void Edit(int id) => NavManager.NavigateTo($"/user-edit/{id}");

    async Task Delete(int id)
    {
        pendingDeleteUserId = id;
        var u = users?.FirstOrDefault(x => x.Id == id);
        deleteMessage = u is null ? "Delete this user?" : $"User \"@{u.Username}\" ({u.FullName})?";
        showDeleteDialog = true;
        await Task.CompletedTask;
    }

    private async Task ConfirmDelete()
    {
        showDeleteDialog = false;
        await UserService.DeleteAsync(pendingDeleteUserId);
        users = (await UserService.GetAllAsync()).ToList();
    }

    private void CancelDelete() => showDeleteDialog = false;
}
