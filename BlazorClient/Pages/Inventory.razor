@page "/inventory"
@attribute [Authorize]

@using System
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using BlazorClient.Services
@using Shared.DTOs

@* offline-first *@
@using BlazorClient.Services.Offline
@using BlazorClient.Services.Sync
@using BlazorClient.Services.Connectivity

@inject IInventoryService InventoryService
@inject NavigationManager NavManager
@inject IJSRuntime JsRuntime
@inject IOfflineDb OfflineDb
@inject OnlineStatusService Online

<div class="wms-header">
    <h3 class="mb-0">Inventory Records</h3>

    <div class="filters">
        <span class="small text-nowrap">Από</span>
        <InputDate TValue="DateTime?" @bind-Value="fromDate" class="form-control form-control-sm wms-date" />
        <span class="small text-nowrap ms-2">Έως</span>
        <InputDate TValue="DateTime?" @bind-Value="toDate" class="form-control form-control-sm wms-date" />
        <button class="btn btn-outline-secondary btn-sm ms-1" @onclick="ClearFilters">Reset</button>

        <input class="form-control wms-search ms-2" placeholder="Search..."
               @bind="searchText" @bind:event="oninput" />
    </div>
</div>

<AuthorizeView Roles="Admin,Employee">
    <div class="mt-2 mb-3 d-flex gap-2 flex-wrap">
        <button class="btn btn-primary" @onclick='() => NavManager.NavigateTo("/inventory-edit")'>
            Create New Inventory
        </button>

        <button class="btn btn-success" @onclick="ExportXlsx">
            <i class="bi bi-download me-1"></i>
            Export as Excel
        </button>
    </div>
</AuthorizeView>

@if (records is null)
{
    <p><em>Loading...</em></p>
}
else if (!VisibleRecords.Any())
{
    <p>No records found.</p>
}
else
{
    <div class="table-responsive wms">
        <div class="wms-table-wrap">
            <table class="table table-striped table-hover wms-table wms-table-sm">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>ScanCode</th>
                        <th>Code</th>
                        <th>Action</th>
                        <th class="text-end">Quantity</th>
                        <th>Timestamp</th>
                        <th>Warehouse</th>
                        <th>User</th>
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                <th class="text-end">Actions</th>
                            </Authorized>
                        </AuthorizeView>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var r in VisibleRecords)
                    {
                        <tr>
                            <td>@r.Id</td>
                            <td>@r.ScanCode</td>
                            <td>@r.Code</td>
                            <td>
                                @if (string.Equals(r.Action, "Input", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge badge-in">Input</span>
                                }
                                else
                                {
                                    <span class="badge badge-out">Output</span>
                                }
                            </td>
                            <td class="text-end">@r.Quantity</td>
                            <td>@r.Timestamp</td>
                            <td>@r.WarehouseName</td>
                            <td>@r.UserName</td>
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <td class="text-end wms-row-actions">
                                        <button class="btn btn-secondary btn-sm me-1"
                                                @onclick='() => NavManager.NavigateTo($"/inventory-edit/{r.Id}")'>
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button class="btn btn-danger btn-sm" @onclick="() => Delete(r.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </Authorized>
                            </AuthorizeView>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (TotalFilteredCount > visibleCount)
    {
        <div class="mt-2">
            <button class="btn btn-outline-primary" @onclick="LoadMore">Περισσότερα...</button>
            <span class="text-muted small ms-2">@visibleCount από @TotalFilteredCount</span>
        </div>
    }
}

<!-- ✅ Confirm Dialog -->
<BlazorClient.Shared2.ConfirmDialog 
    Visible="showDeleteDialog"
    Title="Διαγραφή Εγγραφής Απογραφής"
    Message="@($"Θέλεις σίγουρα να διαγράψεις την εγγραφή #{SelectedRecord?.Id} (Κωδικός: {SelectedRecord?.Code}, ScanCode: {SelectedRecord?.ScanCode});")"
    CancelText="Ακύρωση"
    ConfirmText="Διαγραφή"
    OnConfirm="ConfirmDelete"
    OnCancel="CancelDelete" />

@code {
    private List<InventoryDto>? records;

    // ---- Paging (10-10) ----
    private const int pageSize = 10;
    private int visibleCount = pageSize;

    // Search με reset paging
    private string _searchText = string.Empty;
    private string searchText
    {
        get => _searchText;
        set { if (_searchText != value) { _searchText = value; ResetPaging(); } }
    }

    // Φίλτρα ημερομηνιών με reset paging
    private DateTime? _fromDate;
    private DateTime? fromDate
    {
        get => _fromDate;
        set { if (_fromDate != value) { _fromDate = value; ResetPaging(); } }
    }

    private DateTime? _toDate;
    private DateTime? toDate
    {
        get => _toDate;
        set { if (_toDate != value) { _toDate = value; ResetPaging(); } }
    }

    private bool showDeleteDialog;
    private InventoryDto? SelectedRecord;

    protected override async Task OnInitializedAsync()
    {
        // Daily reset: κράτα μόνο τα σημερινά snapshots
        await OfflineDb.PurgeScansExceptTodayAsync();

        // Local (offline-first)
        var local = await OfflineDb.GetScansAsync();
        records = local
            .OrderByDescending(l => l.Timestamp)
            .Select(l => new InventoryDto
            {
                Id = int.TryParse(l.Id, out var parsedId) ? parsedId : 0,
                ScanCode = l.ScanCode,
                Code = l.Code,
                Action = l.Action,
                Quantity = l.Quantity,
                Timestamp = l.Timestamp,
                WarehouseName = string.IsNullOrWhiteSpace(l.WarehouseName) ? $"#{l.WarehouseId}" : l.WarehouseName,
                UserName = l.User
            })
            .ToList();

        // Server (αν είμαστε online)
        if (Online.IsOnline)
        {
            try
            {
                var server = await InventoryService.GetAllAsync();
                if (server is not null)
                    records = server.OrderByDescending(x => x.Timestamp).ToList();
            }
            catch
            {
                // ignore — μένουμε με τα τοπικά
            }
        }

        ResetPaging();
    }

    // === Filtering ===
    private IEnumerable<InventoryDto> FilteredRecords =>
        (records ?? Enumerable.Empty<InventoryDto>())
            .Where(InDateRange)
            .Where(Matches)
            .OrderByDescending(r => r.Timestamp);

    private IEnumerable<InventoryDto> VisibleRecords => FilteredRecords.Take(visibleCount);
    private int TotalFilteredCount => FilteredRecords.Count();
    private void LoadMore() => visibleCount += pageSize;
    private void ResetPaging() => visibleCount = pageSize;

    // === Filters ===
    private bool Matches(InventoryDto r)
    {
        var q = searchText?.Trim() ?? string.Empty;
        if (q.Length == 0) return true;

        bool Has(string? s) => !string.IsNullOrEmpty(s) &&
                               s.Contains(q, StringComparison.OrdinalIgnoreCase);

        return Has(r.ScanCode)
            || Has(r.Code)
            || Has(r.Action)
            || Has(r.WarehouseName)
            || Has(r.UserName)
            || r.Quantity.ToString(CultureInfo.InvariantCulture).Contains(q, StringComparison.OrdinalIgnoreCase)
            || r.Timestamp.ToString().Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    private bool InDateRange(InventoryDto r)
    {
        if (!fromDate.HasValue && !toDate.HasValue) return true;
        var ts = r.Timestamp;
        if (fromDate.HasValue && ts < fromDate.Value.Date)
            return false;
        if (toDate.HasValue && ts > toDate.Value.Date.AddDays(1).AddTicks(-1))
            return false;
        return true;
    }

    private void ClearFilters()
    {
        fromDate = null;
        toDate = null;
        searchText = string.Empty;
        ResetPaging();
    }

    // === Delete Logic ===
    private async Task Delete(int id)
    {
        SelectedRecord = records?.FirstOrDefault(x => x.Id == id);
        showDeleteDialog = true;
        await Task.CompletedTask;
    }

    private async Task ConfirmDelete()
    {
        showDeleteDialog = false;
        if (SelectedRecord is null) return;

        int id = SelectedRecord.Id;

        if (Online.IsOnline)
        {
            try
            {
                await InventoryService.DeleteAsync(id);
                records = (await InventoryService.GetAllAsync())
                    .OrderByDescending(x => x.Timestamp)
                    .ToList();
                ResetPaging();
                return;
            }
            catch
            {
                // offline fallback
            }
        }

        // offline fallback: enqueue
        await OfflineDb.EnqueueAsync(new PendingItem
        {
            Type = "DELETE",
            Endpoint = $"/api/inventory/{id}",
            PayloadJson = string.Empty,
            CreatedAt = DateTime.UtcNow
        });

        records = records?.Where(x => x.Id != id).ToList();
        ResetPaging();
        SelectedRecord = null;
    }

    private void CancelDelete()
    {
        showDeleteDialog = false;
        SelectedRecord = null;
    }

    // === Export Excel ===
    private async Task ExportXlsx()
    {
        var rows = VisibleRecords.ToList();
        if (!rows.Any()) return;

        string[] headers = new[] { "ScanCode","Code","Action","Quantity","Timestamp","Warehouse","User" };

        var data = rows.Select(r => new object?[]
        {
            r.ScanCode,
            r.Code,
            r.Action,
            r.Quantity,
            r.Timestamp.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture),
            r.WarehouseName,
            r.UserName
        }).ToList();

        var fileName = $"inventory_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
        await JsRuntime.InvokeVoidAsync("exportXlsx", fileName, headers, data);
    }
}
