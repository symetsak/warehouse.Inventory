@page "/inventory"
@attribute [Authorize]
@using BlazorClient.Services
@using Microsoft.AspNetCore.Authorization
@using Shared.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@inject IInventoryService InventoryService
@inject NavigationManager NavManager
@inject IJSRuntime JsRuntime

<h3>Inventory Records</h3>

<!-- Create: επιτρέπεται σε Admin & Employee -->
<AuthorizeView Roles="Admin,Employee">
    <button class="btn btn-primary mb-3" @onclick='() => NavManager.NavigateTo("/inventory-edit")'>
        Create New Inventory
    </button>
</AuthorizeView>

@if (records is null)
{
    <p><em>Loading...</em></p>
}
else if (!records.Any())
{
    <p>No records found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ScanCode</th>
                <th>Code</th>
                <th>Action</th>
                <th>Quantity</th>
                <th>Timestamp</th>
                <th>Warehouse</th>
                <th>User</th>

                <!-- Στήλη ενεργειών φαίνεται μόνο σε Admin -->
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <th></th>
                    </Authorized>
                </AuthorizeView>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in records)
            {
                <tr>
                    <td>@r.ScanCode</td>
                    <td>@r.Code</td>
                    <td>@r.Action</td>
                    <td>@r.Quantity</td>
                    <td>@r.Timestamp</td>
                    <td>@r.WarehouseName</td>
                    <td>@r.UserName</td>

                    <!-- Edit/Delete: μόνο Admin -->
                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <td>
                                <button class="btn btn-sm btn-secondary me-1"
                                        @onclick='() => NavManager.NavigateTo($"/inventory-edit/{r.Id}")'>
                                    Edit
                                </button>
                                <button class="btn btn-sm btn-danger" @onclick="() => Delete(r.Id)">Delete</button>
                            </td>
                        </Authorized>
                    </AuthorizeView>
                </tr>
            }
        </tbody>
    </table>
}

<!-- Confirm dialog -->
<BlazorClient.Shared2.ConfirmDialog 
    Visible="showDeleteDialog"
    Title="Are you sure to delete ?"
    Message="@deleteMessage"
    OnConfirm="ConfirmDelete"
    OnCancel="CancelDelete" />

@code {
    private List<InventoryDto>? records;

    // dialog state
    private bool showDeleteDialog;
    private string deleteMessage = string.Empty;
    private int pendingDeleteId;

    protected override async Task OnInitializedAsync()
    {
        records = (await InventoryService.GetAllAsync()).ToList();
    }

    async Task Delete(int id)
    {
        pendingDeleteId = id;
        var rec = records?.FirstOrDefault(x => x.Id == id);
        deleteMessage = rec is null
            ? "Delete this record?"
            : $"Inventory record #{rec.Id} (Code: {rec.Code})?";
        showDeleteDialog = true;
        await Task.CompletedTask;
    }

    private async Task ConfirmDelete()
    {
        showDeleteDialog = false;
        await InventoryService.DeleteAsync(pendingDeleteId); // θα κοπεί από API για Employee (403)
        records = (await InventoryService.GetAllAsync()).ToList();
    }

    private void CancelDelete() => showDeleteDialog = false;
}
