@page "/inventory"
@attribute [Authorize]

@using System
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using BlazorClient.Services
@using Shared.DTOs

@* offline-first *@
@using BlazorClient.Services.Offline
@using BlazorClient.Services.Sync
@using BlazorClient.Services.Connectivity

@inject IInventoryService InventoryService
@inject NavigationManager NavManager
@inject IJSRuntime JsRuntime

@inject IOfflineDb OfflineDb
@inject OnlineStatusService Online

<div class="wms-header">
    <h3 class="mb-0">Inventory Records</h3>
    <input class="form-control wms-search" placeholder="Search..."
           @bind="searchText" @bind:event="oninput" />
</div>

<!-- Create: μόνο Admin & Employee -->
<AuthorizeView Roles="Admin,Employee">
    <button class="btn btn-primary mb-3" @onclick='() => NavManager.NavigateTo("/inventory-edit")'>
        Create New Inventory
    </button>
</AuthorizeView>

@if (records is null)
{
    <p><em>Loading...</em></p>
}
else if (!FilteredRecords.Any())
{
    <p>No records found.</p>
}
else
{
    <div class="table-responsive wms">
        <div class="wms-table-wrap">
            <table class="table table-striped table-hover wms-table wms-table-sm">
                <thead>
                    <tr>
                        <th>ScanCode</th>
                        <th>Code</th>
                        <th>Action</th>
                        <th class="text-end">Quantity</th>
                        <th>Timestamp</th>
                        <th>Warehouse</th>
                        <th>User</th>
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                <th class="text-end">Actions</th>
                            </Authorized>
                        </AuthorizeView>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in FilteredRecords)
                    {
                        <tr>
                            <td>@r.ScanCode</td>
                            <td>@r.Code</td>
                            <td>
                                @if (string.Equals(r.Action, "Input", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge badge-in">Input</span>
                                }
                                else
                                {
                                    <span class="badge badge-out">Output</span>
                                }
                            </td>
                            <td class="text-end">@r.Quantity</td>
                            <td>@r.Timestamp</td>
                            <td>@r.WarehouseName</td>
                            <td>@r.UserName</td>
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <td class="text-end wms-row-actions">
                                        <button class="btn btn-secondary btn-sm me-1"
                                                @onclick='() => NavManager.NavigateTo($"/inventory-edit/{r.Id}")'>
                                            Edit
                                        </button>
                                        <button class="btn btn-danger btn-sm" @onclick="() => Delete(r.Id)">
                                            Delete
                                        </button>
                                    </td>
                                </Authorized>
                            </AuthorizeView>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<BlazorClient.Shared2.ConfirmDialog Visible="showDeleteDialog"
                                    Title="Are you sure to delete ?"
                                    Message="@deleteMessage"
                                    OnConfirm="ConfirmDelete"
                                    OnCancel="CancelDelete" />

@code {
    private List<InventoryDto>? records;
    private string searchText = string.Empty;

    private bool showDeleteDialog;
    private string deleteMessage = string.Empty;
    private int pendingDeleteId;

    protected override async Task OnInitializedAsync()
    {
        // Daily reset: κράτα μόνο τα σημερινά snapshots
        await OfflineDb.PurgeScansExceptTodayAsync();

        // 1) Φέρε από local DB (offline-first)
        var local = await OfflineDb.GetScansAsync();
        records = local
            .OrderByDescending(l => l.Timestamp)
            .Select(l => new InventoryDto
            {
                ScanCode = l.ScanCode,
                Code = l.Code,
                Action = l.Action,
                Quantity = l.Quantity,                                // FIX #1: σωστή ποσότητα
                Timestamp = l.Timestamp,
                WarehouseName = string.IsNullOrWhiteSpace(l.WarehouseName)
                                ? $"#{l.WarehouseId}"                // FIX #2: πλήρες όνομα αν υπάρχει, αλλιώς fallback
                                : l.WarehouseName,
                UserName = l.User
            })
            .ToList();

        // 2) Αν είμαστε online, μπορείς να φορτώσεις από API (όπως το είχες)
        //    Αν προτιμάς καθαρά local view, σχολίασε το block.
        if (Online.IsOnline)
        {
            try
            {
                var server = await InventoryService.GetAllAsync();
                if (server is not null)
                {
                    records = server.ToList();
                }
            }
            catch
            {
                // ignore — μένουμε με τα τοπικά
            }
        }
    }

    // Προβολή μετά από φιλτράρισμα
    private IEnumerable<InventoryDto> FilteredRecords =>
        string.IsNullOrWhiteSpace(searchText)
        ? records ?? Enumerable.Empty<InventoryDto>()
        : (records ?? Enumerable.Empty<InventoryDto>())
            .Where(Matches);

    // Αναζήτηση σε όλα τα πεδία
    private bool Matches(InventoryDto r)
    {
        var q = searchText.Trim();
        if (q.Length == 0) return true;

        bool Has(string? s) => !string.IsNullOrEmpty(s) &&
                               s.Contains(q, StringComparison.OrdinalIgnoreCase);

        return Has(r.ScanCode)
            || Has(r.Code)
            || Has(r.Action)
            || Has(r.WarehouseName)
            || Has(r.UserName)
            || r.Quantity.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
            || r.Timestamp.ToString().Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    async Task Delete(int id)
    {
        pendingDeleteId = id;
        var rec = records?.FirstOrDefault(x => x.Id == id);
        deleteMessage = rec is null ? "Delete this record?" : $"Inventory record #{rec.Id} (Code: {rec.Code})?";
        showDeleteDialog = true;
        await Task.CompletedTask;
    }

    private async Task ConfirmDelete()
    {
        showDeleteDialog = false;

        if (Online.IsOnline)
        {
            try
            {
                await InventoryService.DeleteAsync(pendingDeleteId);
                records = (await InventoryService.GetAllAsync()).ToList();
                return;
            }
            catch
            {
                // πέφτουμε στο offline fallback
            }
        }

        // offline fallback: βάζουμε σε pending_sync
        await OfflineDb.EnqueueAsync(new PendingItem
        {
            Type = "DELETE",
            Endpoint = $"/api/inventory/{pendingDeleteId}",
            PayloadJson = string.Empty,
            CreatedAt = DateTime.UtcNow
        });

        // προαιρετικά αφαίρεσε τοπικά για να φύγει από τη λίστα
        records = records?.Where(x => x.Id != pendingDeleteId).ToList();
    }

    private void CancelDelete() => showDeleteDialog = false;
}
