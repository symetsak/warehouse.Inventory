@page "/home"
@attribute [Authorize(Roles = "Admin,Employee")]

@using BlazorClient.Services
@using Microsoft.AspNetCore.Authorization
@using Shared.DTOs
@using System.Globalization
@using System.Linq

@inject IJSRuntime Js
@inject BlazorClient.Services.Auth.AuthService AuthService
@inject IInventoryService InventoryService

<PageTitle>Αρχική</PageTitle>

<div class="container mt-4">
    <!-- Input vs Output (Σήμερα) -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <span class="text-input">Input</span>
                <span class="vs-text">VS</span>
                <span class="text-output">Output</span>
                <span class="text-muted">(Σήμερα)</span>
            </h5>
        </div>

        <div class="card-body">

            @if (todayInput + todayOutput == 0)
            {
                <p class="text-muted mb-0">Δεν υπάρχουν δεδομένα για σήμερα.</p>
            }
            else
            {
                <div class="io-bar">
                    <div class="io-input" style="width:@InputPercentCss">
                        <span>@todayInput</span>
                    </div>

                    <div class="io-output" style="width:@OutputPercentCss">
                        <span>@todayOutput</span>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Στατιστικά Απογραφών -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card text-center shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Απογραφές Σήμερα</h6>
                    <h2 class="fw-bold text-primary">@dashboardStats?.TodayInventories</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card text-center shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Απογραφές Εβδομάδας</h6>
                    <h2 class="fw-bold text-success">@dashboardStats?.WeekInventories</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card text-center shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Απογραφές Μήνα</h6>
                    <h2 class="fw-bold text-warning">@dashboardStats?.MonthInventories</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Top 5 Movements Products -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-header bg-light py-2">
            <h6 class="mb-0">Top Products by Movements</h6>
        </div>
        <div class="card-body p-2">
            <canvas id="topProductsChart" height="70"></canvas>
        </div>
    </div>

    <!-- Στατιστικά Αποθήκης -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Στατιστικά Αποθηκών</h5>
                </div>
                <div class="card-body">
                    @if (warehouseStats is null || warehouseStats.Count == 0)
                    {
                        <p class="text-muted mb-0">Δεν βρέθηκαν δεδομένα.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th style="width:45%">Αποθήκη</th>
                                        <th class="text-end" style="width:20%">Προϊόντα</th>
                                        <th class="text-end" style="width:35%">Αξία (€)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var w in warehouseStats)
                                    {
                                        <tr>
                                            <td>@w.WarehouseName</td>
                                            <td class="text-end">@w.ProductCount</td>
                                            <td class="text-end">@w.TotalValue.ToString("C", CultureInfo.GetCultureInfo("el-GR"))</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Κατανομή Προϊόντων & Αξίας ανά Αποθήκη -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light">
            <h6 class="mb-0">Κατανομή Αποθηκών</h6>
        </div>

        <div class="card-body">
            <div class="wms-pie-row">

                <!-- Πίτα Πλήθους Προϊόντων -->
                <div class="wms-pie-container">
                    <h6 class="text-center mb-2">Ποσότητα Προϊόντων</h6>
                    <canvas id="warehousePieProducts"></canvas>
                </div>

                <!-- Πίτα Αξίας Προϊόντων-->
                <div class="wms-pie-container">
                    <h6 class="text-center mb-2">Αξία (€)</h6>
                    <canvas id="warehousePieValue"></canvas>
                </div>

            </div>
        </div>
    </div>



</div>

@code {
    private int todayInput;
    private int todayOutput;
    private DashboardStatsDto? dashboardStats;
    private List<WarehouseStatsDto> warehouseStats = new();
    private List<TopProductMovementDto> topProducts = new();
    private string InputPercentCss => GetPercentCss(todayInput, todayOutput, true);
    private string OutputPercentCss => GetPercentCss(todayInput, todayOutput, false);

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardStats();
        await LoadWarehouseStats();
        await LoadTodayIO();
        await LoadTopProducts();
    }

    private async Task LoadTodayIO()
    {
        var data = await InventoryService.GetTodayIOAsync();
        todayInput = data.Input;
        todayOutput = data.Output;
    }

    private async Task LoadDashboardStats()
    {
        try
        {
            dashboardStats = await InventoryService.GetDashboardStatsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Σφάλμα φόρτωσης στατιστικών: {ex.Message}");
        }
    }

    private async Task LoadWarehouseStats()
    {
        try
        {
            warehouseStats = await InventoryService.GetWarehouseStatsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Σφάλμα φόρτωσης warehouse stats: {ex.Message}");
            warehouseStats = new();
        }
    }

    private async Task LoadTopProducts()
    {
        try
        {
            topProducts = await InventoryService.GetTopProductsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Σφάλμα φόρτωσης top products: {ex.Message}");
            topProducts = new();
        }
    }

    private async Task RenderTopProductsBarAsync()
    {
        if (topProducts == null || topProducts.Count == 0)
            return;

        var labels = topProducts.Select(x => x.Code).ToArray();
        var data = topProducts.Select(x => x.Total).ToArray();

        await Js.InvokeVoidAsync("wmsCharts.renderBarChart",
            "topProductsChart", labels, data);
    }

    private async Task RenderWarehouseProductsPieAsync()
    {
        if (warehouseStats == null || warehouseStats.Count == 0)
            return;

        var labels = warehouseStats.Select(w => w.WarehouseName).ToArray();
        var data = warehouseStats.Select(w => w.ProductCount).ToArray();

        await Js.InvokeVoidAsync(
            "wmsCharts.renderWarehousePie",
            "warehousePieProducts",
            labels,
            data
        );
    }

    private async Task RenderWarehouseValuePieAsync()
    {
        if (warehouseStats == null || warehouseStats.Count == 0)
            return;

        var labels = warehouseStats.Select(w => w.WarehouseName).ToArray();
        var data = warehouseStats.Select(w => (double)w.TotalValue).ToArray();

        await Js.InvokeVoidAsync(
            "wmsCharts.renderWarehousePie",
            "warehousePieValue",
            labels,
            data
        );
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (topProducts != null && topProducts.Count > 0)
        {
            await RenderTopProductsBarAsync();
        }

        if (warehouseStats != null && warehouseStats.Count > 0)
        {
            await RenderWarehouseProductsPieAsync();
            await RenderWarehouseValuePieAsync();
        }
    }


    private string GetPercentCss(int input, int output, bool forInput)
    {
        var total = input + output;
        if (total <= 0)
            return "0%";

        decimal value = forInput
            ? (decimal)input * 100m / total
            : (decimal)output * 100m / total;

        // clamp just in case
        if (value < 0) value = 0;
        if (value > 100) value = 100;

        return value.ToString("0.##", CultureInfo.InvariantCulture) + "%";
    }
}
