@page "/warehouse-edit/{Id:int?}"
@attribute [Authorize]
@using BlazorClient.Services
@using Microsoft.AspNetCore.Authorization
@using Shared.DTOs
@inject IWarehouseService WarehouseService
@inject NavigationManager NavManager

<div class="edit-container">
    <div class="edit-card">
        <div class="edit-header">
            <h3 class="edit-title">@(Id == null ? "Create Warehouse" : "Edit Warehouse")</h3>
        </div>

        <EditForm Model="model" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="edit-body two-col">
                <div class="form-block">
                    <label>Name</label>
                    <InputText @bind-Value="model.Name" class="form-control" />
                </div>

                <div class="form-block">
                    <label>Address</label>
                    <InputText @bind-Value="model.Address" class="form-control" />
                </div>
            </div>

            <div class="edit-footer">
                <button type="submit" class="btn btn-primary">Save</button>
                <button type="button" class="btn btn-secondary" @onclick='() => NavManager.NavigateTo("/warehouses")'>Cancel</button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private CreateWarehouseDto model = new();

    protected override async Task OnInitializedAsync()
    {
        if (Id != null)
        {
            var dto = await WarehouseService.GetByIdAsync(Id.Value);
            if (dto != null)
            {
                model = new CreateWarehouseDto
                    {
                        Name = dto.Name,
                        Address = dto.Address
                    };
            }
        }
    }

    private async Task HandleValidSubmit()
    {
        if (Id == null)
            await WarehouseService.CreateAsync(model);
        else
            await WarehouseService.UpdateAsync(Id.Value, model);

        NavManager.NavigateTo("/warehouses");
    }
}
