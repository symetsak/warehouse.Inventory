@page "/warehouses"
@using BlazorClient.Services
@using Shared.DTOs
@inject IWarehouseService WarehouseService
@inject NavigationManager NavManager
@inject IJSRuntime JsRuntime

<h3>Warehouses</h3>

<button class="btn btn-primary mb-3" @onclick="CreateNew">Create New Warehouse</button>

@if (warehouses is null)
{
    <p><em>Loading...</em></p>
}
else if (!warehouses.Any())
{
    <p>No warehouses found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Address</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var w in warehouses)
            {
                <tr>
                    <td>@w.Id</td>
                    <td>@w.Name</td>
                    <td>@w.Address</td>
                    <td>
                        <button class="btn btn-sm btn-secondary me-1" @onclick="() => Edit(w.Id)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => Delete(w.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- Confirm dialog -->
<BlazorClient.Shared2.ConfirmDialog 
    Visible="showDeleteDialog"
    Title="Are you sure to delete ?"
    Message="@deleteMessage"
    OnConfirm="ConfirmDelete"
    OnCancel="CancelDelete" />

@code {
    private List<WarehouseDto>? warehouses;

    // dialog state
    private bool showDeleteDialog;
    private string deleteMessage = string.Empty;
    private int pendingDeleteId;

    protected override async Task OnInitializedAsync()
    {
        warehouses = (await WarehouseService.GetAllAsync()).ToList();
    }

    void CreateNew() => NavManager.NavigateTo("/warehouse-edit");
    void Edit(int id) => NavManager.NavigateTo($"/warehouse-edit/{id}");

    // ανοίγει το modal
    async Task Delete(int id)
    {
        pendingDeleteId = id;
        var w = warehouses?.FirstOrDefault(x => x.Id == id);
        deleteMessage = w is null
            ? "Delete this warehouse?"
            : $"Warehouse \"{w.Name}\" (ID {w.Id})?";
        showDeleteDialog = true;
        await Task.CompletedTask;
    }

    // επιβεβαίωση από το modal
    private async Task ConfirmDelete()
    {
        showDeleteDialog = false;
        await WarehouseService.DeleteAsync(pendingDeleteId);
        warehouses = (await WarehouseService.GetAllAsync()).ToList();
    }

    // ακύρωση/κλείσιμο modal
    private void CancelDelete() => showDeleteDialog = false;
}
