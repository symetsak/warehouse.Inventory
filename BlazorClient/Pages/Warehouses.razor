@page "/warehouses"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using BlazorClient.Services
@using Shared.DTOs

@inject IWarehouseService WarehouseService
@inject NavigationManager NavManager

<div class="wms-header">
    <h3 class="mb-0">Warehouses</h3>
    <input class="form-control wms-search" placeholder="Search..."
           @bind="searchText" @bind:event="oninput" />
</div>

<AuthorizeView Roles="Admin">
    <button class="btn btn-primary mb-3" @onclick="CreateNew">Create New Warehouse</button>
</AuthorizeView>

@if (warehouses is null)
{
    <p><em>Loading...</em></p>
}
else if (!Filtered.Any())
{
    <p>No warehouses found.</p>
}
else
{
    <div class="table-responsive wms">
        <div class="wms-table-wrap">
            <table class="table table-striped table-hover wms-table wms-table-sm">
                <thead>
                    <tr>
                        <th style="width: 100px;">Id</th>
                        <th>Name</th>
                        <th>Address</th>
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                <th class="text-end" style="width: 160px;">Actions</th>
                            </Authorized>
                        </AuthorizeView>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var w in Filtered)
                    {
                        <tr>
                            <td>@w.Id</td>
                            <td>@w.Name</td>
                            <td>@w.Address</td>
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <td class="text-center actions-cell">
                                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                                            <button class="btn btn-secondary btn-sm me-1" @onclick="() => Edit(w.Id)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="btn btn-danger btn-sm" @onclick="() => Delete(w.Id)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </Authorized>
                            </AuthorizeView>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!--  Confirm Dialog -->
<BlazorClient.Shared2.ConfirmDialog Visible="showDeleteDialog"
                                    Title="Διαγραφή Αποθήκης"
                                    Message="@($"Θέλεις σίγουρα να διαγράψεις την αποθήκη '{SelectedWarehouse?.Name}';")"
                                    CancelText="Ακύρωση"
                                    ConfirmText="Διαγραφή"
                                    OnConfirm="ConfirmDelete"
                                    OnCancel="CancelDelete" />

@code {
    private List<WarehouseDto>? warehouses;
    private string searchText = string.Empty;

    private bool showDeleteDialog;
    private int pendingDeleteId;
    private WarehouseDto? SelectedWarehouse;

    protected override async Task OnInitializedAsync()
    {
        warehouses = (await WarehouseService.GetAllAsync()).ToList();
    }

    private IEnumerable<WarehouseDto> Filtered =>
        string.IsNullOrWhiteSpace(searchText)
        ? warehouses ?? Enumerable.Empty<WarehouseDto>()
        : (warehouses ?? Enumerable.Empty<WarehouseDto>())
            .Where(w =>
                w.Id.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrEmpty(w.Name) && w.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(w.Address) && w.Address.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            );

    void CreateNew() => NavManager.NavigateTo("/warehouse-edit");
    void Edit(int id) => NavManager.NavigateTo($"/warehouse-edit/{id}");

    async Task Delete(int id)
    {
        SelectedWarehouse = warehouses?.FirstOrDefault(x => x.Id == id);
        pendingDeleteId = id;
        showDeleteDialog = true;
        await Task.CompletedTask;
    }

    private async Task ConfirmDelete()
    {
        showDeleteDialog = false;
        if (SelectedWarehouse is null) return;

        await WarehouseService.DeleteAsync(SelectedWarehouse.Id);
        warehouses = (await WarehouseService.GetAllAsync()).ToList();
    }

    private void CancelDelete() => showDeleteDialog = false;
}
