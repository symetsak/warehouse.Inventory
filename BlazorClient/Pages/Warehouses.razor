@page "/warehouses"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using BlazorClient.Services
@using Shared.DTOs

@inject IWarehouseService WarehouseService
@inject NavigationManager NavManager

<h3>Warehouses</h3>

<AuthorizeView Roles="Admin">
    <button class="btn btn-primary mb-3" @onclick="CreateNew">Create New Warehouse</button>
</AuthorizeView>

@if (warehouses is null)
{
    <p><em>Loading...</em></p>
}
else if (!warehouses.Any())
{
    <p>No warehouses found.</p>
}
else
{
    <div class="table-responsive wms">
        <div class="wms-table-wrap">
            <table class="table table-striped table-hover wms-table wms-table-sm">
                <thead>
                    <tr>
                        <th style="width: 100px;">Id</th>
                        <th>Name</th>
                        <th>Address</th>
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                <th class="text-end" style="width: 160px;">Actions</th>
                            </Authorized>
                        </AuthorizeView>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var w in warehouses)
                    {
                        <tr>
                            <td>@w.Id</td>
                            <td>@w.Name</td>
                            <td>@w.Address</td>
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <td class="text-end wms-row-actions">
                                        <button class="btn btn-secondary btn-sm me-1" @onclick="() => Edit(w.Id)">Edit</button>
                                        <button class="btn btn-danger btn-sm" @onclick="() => Delete(w.Id)">Delete</button>
                                    </td>
                                </Authorized>
                            </AuthorizeView>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<BlazorClient.Shared2.ConfirmDialog Visible="showDeleteDialog"
                                    Title="Are you sure to delete ?"
                                    Message="@deleteMessage"
                                    OnConfirm="ConfirmDelete"
                                    OnCancel="CancelDelete" />

@code {
    private List<WarehouseDto>? warehouses;

    private bool showDeleteDialog;
    private string deleteMessage = string.Empty;
    private int pendingDeleteId;

    protected override async Task OnInitializedAsync()
    {
        warehouses = (await WarehouseService.GetAllAsync()).ToList();
    }

    void CreateNew() => NavManager.NavigateTo("/warehouse-edit");
    void Edit(int id) => NavManager.NavigateTo($"/warehouse-edit/{id}");

    async Task Delete(int id)
    {
        pendingDeleteId = id;
        var w = warehouses?.FirstOrDefault(x => x.Id == id);
        deleteMessage = w is null
            ? "Delete this warehouse?"
            : $"Warehouse \"{w.Name}\" (ID {w.Id})?";
        showDeleteDialog = true;
        await Task.CompletedTask;
    }

    private async Task ConfirmDelete()
    {
        showDeleteDialog = false;
        await WarehouseService.DeleteAsync(pendingDeleteId);
        warehouses = (await WarehouseService.GetAllAsync()).ToList();
    }

    private void CancelDelete() => showDeleteDialog = false;
}
